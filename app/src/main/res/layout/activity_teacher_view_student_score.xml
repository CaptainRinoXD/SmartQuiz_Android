<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TeacherActiviy.TeacherViewStudentScore">

    <TextView
        android:id="@+id/emptyStateTextView"
        android:layout_width="200sp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Chưa có học sinh nào nộp bài này."
        android:textColor="#888888"
        android:textSize="20sp"
        android:textStyle="italic"
        app:layout_constraintBottom_toBottomOf="@+id/scrollView6"
        app:layout_constraintEnd_toEndOf="@+id/scrollView6"
        app:layout_constraintStart_toStartOf="@+id/scrollView6"
        app:layout_constraintTop_toTopOf="@+id/scrollView6"
        tools:visibility="visible" />

    <ScrollView
        android:id="@+id/scrollView6"
        android:layout_width="409dp"
        android:layout_height="821dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:id="@+id/list_score_LN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>